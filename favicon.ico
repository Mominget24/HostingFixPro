<svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <!-- Background Card Gradient -->
    <linearGradient id="hmBg" x1="0" y1="0" x2="40" y2="40" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#1e293b"/>
      <stop offset="50%" stop-color="#0f172a"/>
      <stop offset="100%" stop-color="#0b1329"/>
    </linearGradient>

    <!-- Glowing Cyber Border Gradient -->
    <linearGradient id="hmBorder" x1="0" y1="0" x2="40" y2="40" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#38bdf8"/>
      <stop offset="50%" stop-color="#6366f1"/>
      <stop offset="100%" stop-color="#06b6d4"/>
    </linearGradient>

    <!-- Left & Right Server Blade Pillars -->
    <linearGradient id="hmPillars" x1="8" y1="10" x2="32" y2="30" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#60a5fa"/>
      <stop offset="50%" stop-color="#3b82f6"/>
      <stop offset="100%" stop-color="#1d4ed8"/>
    </linearGradient>

    <!-- Architectural 'M' Chevron Blades -->
    <linearGradient id="hmChevron" x1="12" y1="10" x2="28" y2="30" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#38bdf8"/>
      <stop offset="50%" stop-color="#00f2fe"/>
      <stop offset="100%" stop-color="#0284c7"/>
    </linearGradient>

    <!-- Telemetry Live Core (Emerald / Cyan) -->
    <radialGradient id="hmPulse" cx="20" cy="8.5" r="3.5" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#ffffff"/>
      <stop offset="40%" stop-color="#22d3ee"/>
      <stop offset="100%" stop-color="#10b981"/>
    </radialGradient>

    <!-- Outer Glow Filter -->
    <filter id="hmGlow" x="-20%" y="-20%" width="140%" height="140%" filterUnits="userSpaceOnUse">
      <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#38bdf8" flood-opacity="0.4"/>
    </filter>
  </defs>

  <!-- Outer Rounded Squircle Base with Cyber Glow -->
  <rect x="1" y="1" width="38" height="38" rx="9" fill="url(#hmBg)" stroke="url(#hmBorder)" stroke-width="1.75" filter="url(#hmGlow)"/>

  <!-- Left Server Blade Column -->
  <rect x="8" y="11" width="5.5" height="19" rx="2.5" fill="url(#hmPillars)"/>

  <!-- Right Server Blade Column -->
  <rect x="26.5" y="11" width="5.5" height="19" rx="2.5" fill="url(#hmPillars)"/>

  <!-- Center 'M' Architectural Primary Chevron Blade -->
  <path d="M12.5 12L20 22.5L27.5 12H23.5L20 17.5L16.5 12H12.5Z" fill="url(#hmChevron)"/>

  <!-- Secondary Dynamic Speed Fin completing the 'M' structure -->
  <path d="M15 19.5L20 26L25 19.5L26.5 21.5L20 30L13.5 21.5L15 19.5Z" fill="url(#hmChevron)" fill-opacity="0.92"/>

  <!-- Apex Live Telemetry Spark Beacon -->
  <circle cx="20" cy="8.5" r="2.5" fill="url(#hmPulse)"/>
  <circle cx="20" cy="8.5" r="0.9" fill="#ffffff"/>

  <!-- Left Rack Status Indicators -->
  <circle cx="10.75" cy="14.5" r="1.1" fill="#ffffff" fill-opacity="0.95"/>
  <circle cx="10.75" cy="18.5" r="1.1" fill="#38bdf8"/>
  <circle cx="10.75" cy="22.5" r="1.1" fill="#10b981"/>
  <circle cx="10.75" cy="26.5" r="1.1" fill="#38bdf8"/>

  <!-- Right Rack Status Indicators -->
  <circle cx="29.25" cy="14.5" r="1.1" fill="#ffffff" fill-opacity="0.95"/>
  <circle cx="29.25" cy="18.5" r="1.1" fill="#38bdf8"/>
  <circle cx="29.25" cy="22.5" r="1.1" fill="#10b981"/>
  <circle cx="29.25" cy="26.5" r="1.1" fill="#38bdf8"/>
</svg>